import { Theme, SpurxIconButton, SpurxTextInput, SpurxButton } from "theme.slint";

export struct AiChatMessageModel {
    role: string, // "user", "model", "system"
    content: string,
    timestamp: string,
}

export component AiPanel inherits Rectangle {
    width: Theme.ai-panel-width;
    background: Theme.bg-secondary;
    border-color: Theme.border-secondary;

    in property <[AiChatMessageModel]> messages: [];
    in-out property <string> prompt-input: "";
    in-out property <string> selected-provider: "ollama"; // "gemini", "grok", "ollama"
    in-out property <bool> provider-dropdown-open: false;
    in property <bool> is-loading: false;

    callback close-panel();
    callback open-ai-settings();
    callback select-provider(string);
    callback copy-message(string);
    callback send-message(string);
    callback analyze-terminal();
    callback command-help();

    VerticalLayout {
        // AI Header
        Rectangle {
            height: 38px;
            border-color: Theme.border-secondary;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: space-between;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    SpurxIconButton {
                        icon-text: "▶";
                        size: 24px;
                        tooltip: "Collapse AI Panel";
                        clicked => { root.close-panel(); }
                    }

                    Text {
                        text: "AI Assistant";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;

                    // Simple Provider Dropdown Trigger
                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: prov-touch.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: root.provider-dropdown-open ? Theme.accent-primary : Theme.border-secondary;

                        HorizontalLayout {
                            padding-left: 8px; padding-right: 6px; spacing: 4px; alignment: center;
                            Text {
                                text: root.selected-provider == "ollama" ? "🦙 Ollama" :
                                      root.selected-provider == "gemini" ? "✨ Gemini" :
                                      root.selected-provider == "grok" ? "⚡ Grok" : "🤖 LM Studio";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "▾";
                                font-size: 9px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        prov-touch := TouchArea {
                            clicked => { root.provider-dropdown-open = !root.provider-dropdown-open; }
                        }
                    }

                    SpurxIconButton {
                        icon-text: "⚙";
                        size: 24px;
                        tooltip: "AI Settings";
                        clicked => { root.open-ai-settings(); }
                    }
                }
            }
        }

        // Privacy Warning Banner (only for Cloud APIs)
        if (root.selected-provider == "gemini" || root.selected-provider == "grok") : Rectangle {
            height: 48px;
            background: #f59e0b1a;
            border-color: #f59e0b44;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "⚠";
                    font-size: 14px;
                    color: Theme.accent-warning;
                    vertical-alignment: center;
                }

                Text {
                    text: "Cloud AI: Terminal data may be sent to provider API. Use Ollama for private local AI.";
                    font-size: 10px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }

        // Messages Scroll Area
        Rectangle {
            Flickable {
                viewport-y: 0px;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // Welcome card if no messages
                    if root.messages.length == 0 : Rectangle {
                        border-radius: 6px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-secondary;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;

                            Text {
                                text: "🤖 AI Network Assistant";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.accent-primary;
                            }

                            Text {
                                text: "Ask questions about commands, analyze terminal output, or get device-specific configuration help (Cisco, Juniper, Linux, etc.).";
                                font-size: 11px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Chat messages list
                    for msg in root.messages : Rectangle {
                        border-radius: 6px;
                        background: msg.role == "user" ? Theme.bg-elevated : Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: msg.role == "user" ? Theme.border-accent : Theme.border-secondary;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: msg.role == "user" ? "You" : "AI Assistant";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: msg.role == "user" ? Theme.accent-primary : Theme.accent-secondary;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;
                                    Text {
                                        text: msg.timestamp;
                                        font-size: 9px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: 22px;
                                        height: 20px;
                                        border-radius: 3px;
                                        background: copy-btn-touch.has-hover ? Theme.bg-hover : Colors.transparent;

                                        Text {
                                            text: "📋";
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        copy-btn-touch := TouchArea {
                                            clicked => {
                                                root.copy-message(msg.content);
                                            }
                                        }
                                    }
                                }
                            }

                            TextInput {
                                text: msg.content;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 11px;
                                color: Theme.text-primary;
                                selection-background-color: #264f78;
                                selection-foreground-color: #ffffff;
                            }
                        }
                    }

                    if root.is-loading : Rectangle {
                        height: 24px;
                        Text {
                            text: "AI is thinking...";
                            font-size: 11px;
                            color: Theme.accent-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Quick Actions Row
        Rectangle {
            height: 32px;
            border-color: Theme.border-secondary;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: start;

                SpurxButton {
                    text: "🔍 Analyze Output";
                    variant: "secondary";
                    custom-height: 24px;
                    custom-padding: 8px;
                    font-size: 10px;
                    clicked => { root.analyze-terminal(); }
                }

                SpurxButton {
                    text: "❓ Command Help";
                    variant: "secondary";
                    custom-height: 24px;
                    custom-padding: 8px;
                    font-size: 10px;
                    clicked => { root.command-help(); }
                }
            }
        }

        // Input Box & Send Button
        Rectangle {
            height: 48px;
            background: Theme.bg-tertiary;
            border-color: Theme.border-secondary;

            HorizontalLayout {
                padding: 6px;
                spacing: 6px;

                SpurxTextInput {
                    text <=> root.prompt-input;
                    placeholder: "Ask AI about commands...";
                    accepted => {
                        if root.prompt-input != "" {
                            root.send-message(root.prompt-input);
                            root.prompt-input = "";
                        }
                    }
                }

                SpurxButton {
                    text: "➤";
                    variant: "primary";
                    custom-height: 32px;
                    custom-padding: 12px;
                    clicked => {
                        if root.prompt-input != "" {
                            root.send-message(root.prompt-input);
                            root.prompt-input = "";
                        }
                    }
                }
            }
        }
    }

    // Dismiss Backdrop for Provider Dropdown
    if root.provider-dropdown-open : TouchArea {
        x: 0; y: 0; width: 10000px; height: 10000px; z: 150;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.provider-dropdown-open = false;
            }
        }
    }

    // Floating Provider Dropdown Menu
    if root.provider-dropdown-open : Rectangle {
        x: parent.width - 160px;
        y: 38px;
        width: 150px;
        height: 140px;
        border-radius: 6px;
        background: Theme.bg-elevated;
        border-width: 1px;
        border-color: Theme.border-primary;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000aa;
        z: 200;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            // 1. Ollama
            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: root.selected-provider == "ollama" ? Theme.bg-active : (p1.has-hover ? Theme.bg-hover : Colors.transparent);
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: space-between;
                    Text { text: "🦙 Ollama"; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; }
                    if root.selected-provider == "ollama" : Text { text: "✓"; font-size: 12px; color: Theme.accent-primary; vertical-alignment: center; }
                }
                p1 := TouchArea {
                    clicked => {
                        root.selected-provider = "ollama";
                        root.provider-dropdown-open = false;
                        root.select-provider("ollama");
                    }
                }
            }

            // 2. LM Studio
            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: root.selected-provider == "lmstudio" ? Theme.bg-active : (p4.has-hover ? Theme.bg-hover : Colors.transparent);
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: space-between;
                    Text { text: "🤖 LM Studio"; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; }
                    if root.selected-provider == "lmstudio" : Text { text: "✓"; font-size: 12px; color: Theme.accent-primary; vertical-alignment: center; }
                }
                p4 := TouchArea {
                    clicked => {
                        root.selected-provider = "lmstudio";
                        root.provider-dropdown-open = false;
                        root.select-provider("lmstudio");
                    }
                }
            }

            // 3. Gemini
            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: root.selected-provider == "gemini" ? Theme.bg-active : (p2.has-hover ? Theme.bg-hover : Colors.transparent);
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: space-between;
                    Text { text: "✨ Gemini"; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; }
                    if root.selected-provider == "gemini" : Text { text: "✓"; font-size: 12px; color: Theme.accent-primary; vertical-alignment: center; }
                }
                p2 := TouchArea {
                    clicked => {
                        root.selected-provider = "gemini";
                        root.provider-dropdown-open = false;
                        root.select-provider("gemini");
                    }
                }
            }

            // 4. Grok
            Rectangle {
                height: 30px;
                border-radius: 4px;
                background: root.selected-provider == "grok" ? Theme.bg-active : (p3.has-hover ? Theme.bg-hover : Colors.transparent);
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: space-between;
                    Text { text: "⚡ Grok"; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; }
                    if root.selected-provider == "grok" : Text { text: "✓"; font-size: 12px; color: Theme.accent-primary; vertical-alignment: center; }
                }
                p3 := TouchArea {
                    clicked => {
                        root.selected-provider = "grok";
                        root.provider-dropdown-open = false;
                        root.select-provider("grok");
                    }
                }
            }
        }
    }
}
