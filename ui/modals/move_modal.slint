import { Theme, SpurxButton, SpurxTextInput, ModalCard } from "../theme.slint";

export component MoveModal inherits Rectangle {
    in property <bool> is-open: false;
    in property <string> item-type: "session"; // "session" or "command"
    in property <string> item-id: "";
    in property <string> item-name: "";
    in property <string> current-folder: "";
    in property <[string]> existing-folders: [];
    in-out property <string> target-folder: "";

    callback close();
    callback move-item(string, string, string); // item-type, item-id, target-folder

    visible: root.is-open;

    ModalCard {
        title: "Move to Folder";
        card-width: 440px;
        card-height: 280px;
        close-requested => { root.close(); }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Move " + (root.item-type == "session" ? "Session" : "Command") + ":";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.text-muted;
                }
                Text {
                    text: root.item-name;
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                if root.current-folder != "" : Text {
                    text: "Current folder: " + root.current-folder;
                    font-size: 11px;
                    color: Theme.accent-primary;
                }
            }

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Target Folder Name (leave blank for root):";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                }
                SpurxTextInput {
                    text <=> root.target-folder;
                    placeholder: "e.g. Production, Routers, Lab...";
                }

                // Existing folders chips
                if root.existing-folders.length > 0 : HorizontalLayout {
                    spacing: 6px;
                    padding-top: 4px;
                    alignment: start;

                    Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: root.target-folder == "" ? Theme.accent-primary.darker(0.6) : Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: root.target-folder == "" ? Theme.accent-primary : Theme.border-secondary;

                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; alignment: center;
                            Text {
                                text: "📁 Root (No Folder)";
                                font-size: 10px;
                                font-weight: 600;
                                color: root.target-folder == "" ? Theme.accent-primary : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.target-folder = ""; } }
                    }

                    for f in root.existing-folders : Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: root.target-folder == f ? Theme.accent-primary.darker(0.6) : Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: root.target-folder == f ? Theme.accent-primary : Theme.border-secondary;

                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; alignment: center;
                            Text {
                                text: "📁 " + f;
                                font-size: 10px;
                                font-weight: 600;
                                color: root.target-folder == f ? Theme.accent-primary : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.target-folder = f; } }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                SpurxButton {
                    text: "Cancel";
                    variant: "secondary";
                    custom-height: 32px;
                    clicked => { root.close(); }
                }
                SpurxButton {
                    text: "Move";
                    variant: "primary";
                    custom-height: 32px;
                    clicked => {
                        root.move-item(root.item-type, root.item-id, root.target-folder);
                        root.close();
                    }
                }
            }
        }
    }
}
