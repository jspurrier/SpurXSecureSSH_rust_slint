import { Theme, SpurxButton, SpurxTextInput, ModalCard } from "../theme.slint";

export component MasterPasswordModal inherits Rectangle {
    in property <bool> is-open: false;
    in property <bool> is-prompt-mode: false; // true: Prompt unlock, false: Set/Change master password
    in property <bool> has-existing-password: false;

    in-out property <string> old-password: "";
    in-out property <string> new-password: "";
    in-out property <string> confirm-password: "";
    in property <string> error-message: "";

    callback close();
    callback submit-password(string, string); // old_pwd, new_pwd (or unlock password)

    visible: root.is-open;

    ModalCard {
        title: root.is-prompt-mode ? "Master Password Required" : "Set Master Password";
        card-width: 400px;
        card-height: 280px;
        close-requested => { root.close(); }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            if root.is-prompt-mode : VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Enter your Master Password to decrypt your saved sessions.";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                SpurxTextInput {
                    text <=> root.new-password;
                    placeholder: "Master password...";
                    is-password: true;
                    accepted => { root.submit-password(root.old-password, root.new-password); }
                }
            }

            if !root.is-prompt-mode : VerticalLayout {
                spacing: 8px;

                if root.has-existing-password : VerticalLayout {
                    spacing: 4px;
                    Text { text: "Current Password:"; font-size: 11px; color: Theme.text-secondary; }
                    SpurxTextInput { text <=> root.old-password; placeholder: "Current password..."; is-password: true; }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "New Master Password:"; font-size: 11px; color: Theme.text-secondary; }
                    SpurxTextInput { text <=> root.new-password; placeholder: "Leave blank to disable password protection"; is-password: true; }
                }
            }

            if root.error-message != "" : Text {
                text: root.error-message;
                font-size: 11px;
                color: Theme.accent-danger;
            }

            Rectangle { }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                SpurxButton {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => { root.close(); }
                }

                SpurxButton {
                    text: root.is-prompt-mode ? "Unlock" : "Save Password";
                    variant: "primary";
                    clicked => { root.submit-password(root.old-password, root.new-password); }
                }
            }
        }
    }
}
