                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                Rectangle { width: 14px; height: 14px; border-radius: 3px; background: #221f22; border-width: 1.5px; border-color: #ffd866; y: 11px; }
                                                Text { text: "Monokai Pro"; font-size: 11px; font-weight: root.color-scheme == "Monokai Pro" ? 700 : 500; color: Theme.text-primary; vertical-alignment: center; }
                                            }
                                            d8-touch := TouchArea { clicked => { root.color-scheme = "Monokai Pro"; root.color-scheme-changed("Monokai Pro"); } }
                                        }

                                        // Solarized Dark
