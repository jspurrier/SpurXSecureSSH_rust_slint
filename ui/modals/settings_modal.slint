                                        border-width: root.accent-color == "pink" ? 2.5px : 1px;
                                        border-color: root.accent-color == "pink" ? #ffffff : #00000040;
                                        if root.accent-color == "pink" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
