import { Theme, SpurxButton, SpurxTextInput, SpurxCheckBox, ModalCard } from "../theme.slint";

export struct KnownHostItemModel {
    name: string,
    key-type: string,
    fingerprint: string,
}

export component SettingsModal inherits Rectangle {
    in property <bool> is-open: false;
    in-out property <int> active-tab: 0; // 0: Terminal, 1: Appearance, 2: Connection, 3: Security, 4: Logging, 5: Behavior

    // Terminal Settings
    in-out property <string> font-family: "JetBrains Mono";
    in-out property <string> font-size: "14";
    in-out property <string> scrollback-lines: "10000";
    in-out property <bool> cursor-blink: true;
    in property <[string]> available-fonts: [];

    public function increment-font-size() {
        let cur = root.font-size.to-float();
        let val = cur > 0.0 ? cur : 14.0;
        let next = min(36.0, val + 1.0);
        root.font-size = "" + round(next);
    }

    public function decrement-font-size() {
        let cur = root.font-size.to-float();
        let val = cur > 0.0 ? cur : 14.0;
        let prev = max(8.0, val - 1.0);
        root.font-size = "" + round(prev);
    }

    // Appearance Settings
    in-out property <string> theme-mode: "dark";
    in-out property <string> color-scheme: "GitHub Dark";
    in-out property <string> accent-color: "cyan";

    // Connection
    in-out property <string> default-port: "22";
    in-out property <string> timeout-secs: "30";
    in-out property <string> keepalive-secs: "60";
    in-out property <string> global-username: "";
    in-out property <string> global-password: "";
    in-out property <string> config-dir: "";

    // Logging
    in-out property <bool> logging-enabled: false;
    in-out property <string> log-dir: "";
    in-out property <string> log-format: "{session}_{date}_{time}.log";
    in-out property <bool> log-timestamps: true;

    // Security
    in property <bool> master-password-set: false;
    in property <[KnownHostItemModel]> known-hosts: [];
    in-out property <string> known-hosts-filter: "";

    // Behavior
    in-out property <bool> confirm-close: true;
    in-out property <bool> restore-sessions: false;
    in-out property <bool> remember-expanded-folders: false;
    in-out property <bool> single-click-launch: false;

    callback close();
    callback theme-mode-changed(string);
    callback color-scheme-changed(string);
    callback accent-color-changed(string);
    callback save-settings(string, string, string, string, string, bool, string, string, bool, string, string, string, bool, bool, bool, bool, bool, string, string, string);
    callback open-key-manager();
    callback change-master-password();
    callback delete-known-host(string);
    callback clear-known-hosts();
    callback refresh-known-hosts();
    callback browse-storage-dir();
    callback open-storage-dir();
    callback browse-log-dir();
    callback open-log-dir();

    visible: root.is-open;

    ModalCard {
        title: "Settings";
        card-width: 630px;
        card-height: 630px;
        close-requested => { root.close(); }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Settings Tab Navigation Row
            Rectangle {
                height: 42px;
                background: Theme.bg-tertiary;
                border-width: 1px;
                border-color: Theme.border-secondary;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 4px;

                    for name[idx] in ["Terminal", "Appearance", "Connection", "Security", "Logging", "Behavior"] : tab-btn := Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: root.active-tab == idx ? Theme.bg-active :
                                    tab-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                        border-width: root.active-tab == idx ? 1px : 0px;
                        border-color: root.active-tab == idx ? Theme.accent-primary : Colors.transparent;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            Text {
                                text: name;
                                font-size: 11px;
                                font-weight: root.active-tab == idx ? 700 : 500;
                                color: root.active-tab == idx ? Theme.accent-primary :
                                       tab-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        tab-touch := TouchArea {
                            clicked => { root.active-tab = idx; }
                        }
                    }
                }
            }

            // Tab Content Container
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-primary;

                // Tab 0: Terminal
                if root.active-tab == 0 : Flickable {
                    viewport-height: 520px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: Theme.border-primary;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                Text {
                                    text: "🖥  Terminal Font & Rendering";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }

                                // Font Family Input & System Font Selector
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Terminal Font Family:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                    SpurxTextInput { text <=> root.font-family; placeholder: "e.g. JetBrains Mono, Lucida Console, Hack"; }

                                    // System Monospace Font Quick Picker
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Installed System Fonts:"; font-size: 10px; font-weight: 600; color: Theme.text-muted; }
                                        Text { text: root.available-fonts.length + " fonts detected"; font-size: 10px; color: Theme.text-muted; }
                                    }
                                    Rectangle {
                                        height: 80px;
                                        border-radius: 5px;
                                        background: Theme.bg-secondary;
                                        border-width: 1px;
                                        border-color: Theme.border-secondary;
                                        clip: true;

                                        Flickable {
                                            width: 100%;
                                            height: 100%;
                                            VerticalLayout {
                                                padding: 3px;
                                                spacing: 2px;
                                                for f[f-idx] in root.available-fonts : font-item := Rectangle {
                                                    height: 22px;
                                                    border-radius: 3px;
                                                    background: root.font-family == f ? Theme.bg-active : (fi-touch.has-hover ? Theme.bg-hover : Colors.transparent);
                                                    border-width: root.font-family == f ? 1px : 0px;
                                                    border-color: Theme.accent-primary;

                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        alignment: space-between;
                                                        Text {
                                                            text: f;
                                                            font-size: 11px;
                                                            font-family: f;
                                                            font-weight: root.font-family == f ? 700 : 400;
                                                            color: root.font-family == f ? Theme.accent-primary : Theme.text-primary;
                                                            vertical-alignment: center;
                                                        }
                                                        if root.font-family == f : Text {
                                                            text: "✓";
                                                            font-size: 11px;
                                                            color: Theme.accent-primary;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    fi-touch := TouchArea {
                                                        clicked => {
                                                            root.font-family = f;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Font Size Stepper & Scrollback
                                HorizontalLayout {
                                    spacing: 12px;

                                    VerticalLayout {
                                        width: 220px;
                                        spacing: 4px;
                                        Text { text: "Terminal Font Size (pt):"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: start;

                                            // Minus button
                                            Rectangle {
                                                width: 30px;
                                                height: 30px;
                                                border-radius: 4px;
                                                background: f-minus-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary;
                                                border-width: 1px;
                                                border-color: Theme.border-primary;
                                                Text { text: "－"; font-size: 13px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                                                f-minus-touch := TouchArea {
                                                    clicked => { root.decrement-font-size(); }
                                                }
                                            }

                                            // Input box
                                            Rectangle {
                                                width: 60px;
                                                height: 30px;
                                                SpurxTextInput {
                                                    text <=> root.font-size;
                                                    placeholder: "14";
                                                }
                                            }

                                            // Plus button
                                            Rectangle {
                                                width: 30px;
                                                height: 30px;
                                                border-radius: 4px;
                                                background: f-plus-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary;
                                                border-width: 1px;
                                                border-color: Theme.border-primary;
                                                Text { text: "＋"; font-size: 13px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                                                f-plus-touch := TouchArea {
                                                    clicked => { root.increment-font-size(); }
                                                }
                                            }

                                            // Default 14pt button
                                            Rectangle {
                                                height: 30px;
                                                border-radius: 4px;
                                                background: f-rst-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary;
                                                border-width: 1px;
                                                border-color: Theme.border-primary;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    Text { text: "Reset"; font-size: 10px; color: Theme.text-secondary; vertical-alignment: center; }
                                                }
                                                f-rst-touch := TouchArea {
                                                    clicked => { root.font-size = "14"; }
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: "Scrollback Buffer Lines:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                        SpurxTextInput { text <=> root.scrollback-lines; placeholder: "10000"; }
                                    }
                                }

                                // Live Terminal Font Preview Card
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "Live Terminal Font Preview:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                    Rectangle {
                                        height: 64px;
                                        border-radius: 6px;
                                        background: Theme.term-bg;
                                        border-width: 1px;
                                        border-color: Theme.border-secondary;
                                        clip: true;

                                        VerticalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "router# show ip interface brief";
                                                font-family: root.font-family;
                                                font-size: max(9.0, min(24.0, root.font-size.to-float())) * 1px;
                                                color: Theme.term-fg;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: "GigabitEthernet0/0/0  192.168.1.1  YES NVRAM  up  up";
                                                font-family: root.font-family;
                                                font-size: max(9.0, min(24.0, root.font-size.to-float())) * 1px;
                                                color: Theme.accent-primary;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border-secondary; }

                                SpurxCheckBox {
                                    checked <=> root.cursor-blink;
                                    text: "Enable blinking terminal cursor";
                                }
                            }
                        }
                    }
                }

                // Tab 1: Appearance
                if root.active-tab == 1 : Flickable {
                    viewport-height: 440px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        alignment: start;

                        // 1. Theme Mode Card (Dark / Light / System)
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: Theme.border-primary;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "🌗  Theme Mode";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.theme-mode == "system" ? "Auto-detecting OS theme" :
                                              root.theme-mode == "light" ? "Light appearance" : "Dark appearance";
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    // Dark Mode Tile
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        border-radius: 6px;
                                        background: root.theme-mode == "dark" ? Theme.bg-active : (t-dark-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                        border-width: root.theme-mode == "dark" ? 1.5px : 1px;
                                        border-color: root.theme-mode == "dark" ? Theme.accent-primary : Theme.border-secondary;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "🌙"; font-size: 13px; vertical-alignment: center; }
                                            Text {
                                                text: "Dark";
                                                font-size: 11px;
                                                font-weight: root.theme-mode == "dark" ? 700 : 500;
                                                color: root.theme-mode == "dark" ? Theme.accent-primary : Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }

                                        t-dark-touch := TouchArea {
                                            clicked => {
                                                root.theme-mode = "dark";
                                                root.theme-mode-changed("dark");
                                            }
                                        }
                                    }

                                    // Light Mode Tile
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        border-radius: 6px;
                                        background: root.theme-mode == "light" ? Theme.bg-active : (t-light-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                        border-width: root.theme-mode == "light" ? 1.5px : 1px;
                                        border-color: root.theme-mode == "light" ? Theme.accent-primary : Theme.border-secondary;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "☀️"; font-size: 13px; vertical-alignment: center; }
                                            Text {
                                                text: "Light";
                                                font-size: 11px;
                                                font-weight: root.theme-mode == "light" ? 700 : 500;
                                                color: root.theme-mode == "light" ? Theme.accent-primary : Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }

                                        t-light-touch := TouchArea {
                                            clicked => {
                                                root.theme-mode = "light";
                                                root.theme-mode-changed("light");
                                            }
                                        }
                                    }

                                    // System Mode Tile
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        border-radius: 6px;
                                        background: root.theme-mode == "system" ? Theme.bg-active : (t-sys-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                        border-width: root.theme-mode == "system" ? 1.5px : 1px;
                                        border-color: root.theme-mode == "system" ? Theme.accent-primary : Theme.border-secondary;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "💻"; font-size: 13px; vertical-alignment: center; }
                                            Text {
                                                text: "System";
                                                font-size: 11px;
                                                font-weight: root.theme-mode == "system" ? 700 : 500;
                                                color: root.theme-mode == "system" ? Theme.accent-primary : Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }

                                        t-sys-touch := TouchArea {
                                            clicked => {
                                                root.theme-mode = "system";
                                                root.theme-mode-changed("system");
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. Color Palette / Theme Presets Card (9 Dark vs 9 Light based on Mode)
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: Theme.border-primary;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: (root.theme-mode == "dark" || (root.theme-mode == "system" && Theme.is-dark)) ? "🎨  Dark Theme Palettes (9 Curated Presets)" : "🎨  Light Theme Palettes (9 Curated Presets)";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Instant live preview on click";
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                // 9 DARK THEMES GRID
                                if (root.theme-mode == "dark" || (root.theme-mode == "system" && Theme.is-dark)) : VerticalLayout {
                                    spacing: 6px;

                                    // Dark Row 1: GitHub Dark, Midnight Navy, Cyberpunk
                                    HorizontalLayout {
                                        spacing: 8px;

                                        // GitHub Dark
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "GitHub Dark" ? Theme.bg-active : (d1-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "GitHub Dark" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "GitHub Dark" ? Theme.accent-primary : Theme.border-secondary;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                Rectangle { width: 14px; height: 14px; border-radius: 3px; background: #0a0e14; border-width: 1.5px; border-color: #00d4ff; y: 11px; }
                                                Text { text: "GitHub Dark"; font-size: 11px; font-weight: root.color-scheme == "GitHub Dark" ? 700 : 500; color: Theme.text-primary; vertical-alignment: center; }
                                            }
                                            d1-touch := TouchArea { clicked => { root.color-scheme = "GitHub Dark"; root.color-scheme-changed("GitHub Dark"); } }
                                        }

                                        // Midnight Navy
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Midnight Navy" ? Theme.bg-active : (d2-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Midnight Navy" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "Midnight Navy" ? Theme.accent-primary : Theme.border-secondary;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                Rectangle { width: 14px; height: 14px; border-radius: 3px; background: #080c16; border-width: 1.5px; border-color: #38bdf8; y: 11px; }
                                                Text { text: "Midnight Navy"; font-size: 11px; font-weight: root.color-scheme == "Midnight Navy" ? 700 : 500; color: Theme.text-primary; vertical-alignment: center; }
                                            }
                                            d2-touch := TouchArea { clicked => { root.color-scheme = "Midnight Navy"; root.color-scheme-changed("Midnight Navy"); } }
                                        }

                                        // Cyberpunk
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Cyberpunk" ? Theme.bg-active : (d3-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Cyberpunk" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "Cyberpunk" ? Theme.accent-primary : Theme.border-secondary;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                Rectangle { width: 14px; height: 14px; border-radius: 3px; background: #08070e; border-width: 1.5px; border-color: #c084fc; y: 11px; }
                                                Text { text: "Cyberpunk"; font-size: 11px; font-weight: root.color-scheme == "Cyberpunk" ? 700 : 500; color: Theme.text-primary; vertical-alignment: center; }
                                            }
                                            d3-touch := TouchArea { clicked => { root.color-scheme = "Cyberpunk"; root.color-scheme-changed("Cyberpunk"); } }
                                        }
                                    }

                                    // Dark Row 2: Emerald Matrix, Tokyo Night, Nord Slate
                                    HorizontalLayout {
                                        spacing: 8px;

                                        // Emerald Matrix
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Emerald Matrix" ? Theme.bg-active : (d4-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Emerald Matrix" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "Emerald Matrix" ? Theme.accent-primary : Theme.border-secondary;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                Rectangle { width: 14px; height: 14px; border-radius: 3px; background: #060d09; border-width: 1.5px; border-color: #10b981; y: 11px; }
                                                Text { text: "Emerald Matrix"; font-size: 11px; font-weight: root.color-scheme == "Emerald Matrix" ? 700 : 500; color: Theme.text-primary; vertical-alignment: center; }
                                            }
                                            d4-touch := TouchArea { clicked => { root.color-scheme = "Emerald Matrix"; root.color-scheme-changed("Emerald Matrix"); } }
                                        }

                                        // Tokyo Night
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Tokyo Night" ? Theme.bg-active : (d5-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Tokyo Night" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "Tokyo Night" ? Theme.accent-primary : Theme.border-secondary;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                Rectangle { width: 14px; height: 14px; border-radius: 3px; background: #1a1b26; border-width: 1.5px; border-color: #7aa2f7; y: 11px; }
                                                Text { text: "Tokyo Night"; font-size: 11px; font-weight: root.color-scheme == "Tokyo Night" ? 700 : 500; color: Theme.text-primary; vertical-alignment: center; }
                                            }
                                            d5-touch := TouchArea { clicked => { root.color-scheme = "Tokyo Night"; root.color-scheme-changed("Tokyo Night"); } }
                                        }

                                        // Nord Slate
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Nord Slate" ? Theme.bg-active : (d6-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Nord Slate" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "Nord Slate" ? Theme.accent-primary : Theme.border-secondary;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                Rectangle { width: 14px; height: 14px; border-radius: 3px; background: #242933; border-width: 1.5px; border-color: #88c0d0; y: 11px; }
                                                Text { text: "Nord Slate"; font-size: 11px; font-weight: root.color-scheme == "Nord Slate" ? 700 : 500; color: Theme.text-primary; vertical-alignment: center; }
                                            }
                                            d6-touch := TouchArea { clicked => { root.color-scheme = "Nord Slate"; root.color-scheme-changed("Nord Slate"); } }
                                        }
                                    }

                                    // Dark Row 3: Dracula, Monokai Pro, Solarized Dark
                                    HorizontalLayout {
                                        spacing: 8px;

                                        // Dracula
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Dracula" ? Theme.bg-active : (d7-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Dracula" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "Dracula" ? Theme.accent-primary : Theme.border-secondary;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                Rectangle { width: 14px; height: 14px; border-radius: 3px; background: #282a36; border-width: 1.5px; border-color: #ff79c6; y: 11px; }
                                                Text { text: "Dracula"; font-size: 11px; font-weight: root.color-scheme == "Dracula" ? 700 : 500; color: Theme.text-primary; vertical-alignment: center; }
                                            }
                                            d7-touch := TouchArea { clicked => { root.color-scheme = "Dracula"; root.color-scheme-changed("Dracula"); } }
                                        }

                                        // Monokai Pro
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Monokai Pro" ? Theme.bg-active : (d8-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Monokai Pro" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "Monokai Pro" ? Theme.accent-primary : Theme.border-secondary;
