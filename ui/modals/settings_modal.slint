                                    }
                                }
                            }
                        }
                    }
                }

                // Tab 2: Connection
                if root.active-tab == 2 : VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    alignment: start;

                    // Section 1: Connection Defaults
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-primary;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "⚡  SSH Protocol Defaults";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                VerticalLayout {
                                    width: 120px;
                                    spacing: 3px;
                                    Text { text: "Default Port:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                    SpurxTextInput { text <=> root.default-port; placeholder: "22"; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: "Timeout (seconds):"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                    SpurxTextInput { text <=> root.timeout-secs; placeholder: "30"; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: "Keepalive (seconds):"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                    SpurxTextInput { text <=> root.keepalive-secs; placeholder: "60"; }
                                }
                            }
                        }
                    }

                    // Section 2: Global Credentials
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-primary;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "👤  Global SSH Credentials";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: "Default credentials applied when 'Use Global Credentials' is enabled on sessions or quick connect.";
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: "Global Username:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                    SpurxTextInput { text <=> root.global-username; placeholder: "e.g. root, admin, ubuntu"; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: "Global Password:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                    SpurxTextInput { text <=> root.global-password; placeholder: "Default password"; is-password: true; }
                                }
                            }
                        }
                    }

                    // Section 3: App Configuration & Storage
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-primary;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;

                            Text {
                                text: "📁  Application Storage Directory";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                SpurxTextInput {
                                    text <=> root.config-dir;
                                    read-only: true;
                                    horizontal-stretch: 1;
                                }
                                SpurxButton {
                                    text: "Browse...";
                                    variant: "secondary";
                                    custom-height: 28px;
                                    clicked => { root.browse-storage-dir(); }
                                }
                                SpurxButton {
                                    text: "Open Folder";
                                    variant: "secondary";
                                    custom-height: 28px;
                                    clicked => { root.open-storage-dir(); }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // Tab 3: Security
                if root.active-tab == 3 : VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;

                    // SSH Key Manager Card
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-primary;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text { text: "🔑  SSH Key Manager"; font-size: 12px; font-weight: 700; color: Theme.text-primary; }
                            Text { text: "Generate, import, and manage ED25519 and RSA private/public key pairs."; font-size: 11px; color: Theme.text-secondary; }

                            HorizontalLayout {
                                alignment: start;
                                SpurxButton {
                                    text: "Open SSH Key Manager...";
                                    variant: "primary";
                                    custom-height: 28px;
                                    clicked => { root.open-key-manager(); }
                                }
                            }
                        }
                    }

                    // Master Password Card
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-primary;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text { text: "🔒  Master Password Vault Encryption"; font-size: 12px; font-weight: 700; color: Theme.text-primary; }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Vault Status:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; vertical-alignment: center; }
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: root.master-password-set ? Theme.accent-success.darker(0.6) : Theme.accent-secondary.darker(0.6);
                                    border-width: 1px;
                                    border-color: root.master-password-set ? Theme.accent-success : Theme.accent-secondary;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; alignment: center;
                                        Text {
                                            text: root.master-password-set ? "Enabled (AES-256-GCM Encrypted)" : "Disabled (Plaintext Storage)";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: root.master-password-set ? Theme.accent-success : Theme.accent-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                SpurxButton {
                                    text: root.master-password-set ? "Change Master Password..." : "Set Master Password...";
                                    variant: "secondary";
                                    custom-height: 28px;
                                    clicked => { root.change-master-password(); }
                                }
                            }
                        }
                    }

                    // Known Hosts Manager Card
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-primary;
                        height: 220px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "🛡️  Known Hosts Manager (~/.ssh/known_hosts)"; font-size: 12px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    SpurxButton {
                                        text: "Refresh";
                                        variant: "secondary";
                                        custom-height: 24px;
                                        clicked => { root.refresh-known-hosts(); }
                                    }
                                    SpurxButton {
                                        text: "Clear All";
                                        variant: "danger";
                                        custom-height: 24px;
                                        clicked => { root.clear-known-hosts(); }
                                    }
                                }
                            }

                            // Filter input
                            SpurxTextInput {
                                text <=> root.known-hosts-filter;
                                placeholder: "🔍 Filter host by name or IP...";
                            }

                            // Known hosts list
                            Rectangle {
                                background: Theme.bg-secondary;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border-secondary;
                                vertical-stretch: 1;
                                clip: true;

                                Flickable {
                                    viewport-y: 0px;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 3px;

                                        for kh in root.known-hosts : Rectangle {
                                            height: 32px;
                                            border-radius: 4px;
                                            background: kh-touch.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
                                            border-width: 1px;
                                            border-color: Theme.border-secondary;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                alignment: space-between;

                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    Text {
                                                        text: kh.name;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Theme.text-primary;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: kh.key-type + " • " + kh.fingerprint;
                                                        font-size: 9px;
                                                        color: Theme.text-muted;
                                                        overflow: elide;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 24px;
                                                    height: 24px;
                                                    border-radius: 4px;
                                                    background: del-kh-touch.has-hover ? #f8514930 : Colors.transparent;
                                                    y: 4px;

                                                    Text {
                                                        text: "🗑";
                                                        font-size: 11px;
                                                        color: #f85149;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }

                                                    del-kh-touch := TouchArea {
                                                        clicked => { root.delete-known-host(kh.name); }
                                                    }
                                                }
                                            }

                                            kh-touch := TouchArea {}
                                        }

                                        if root.known-hosts.length == 0 : Rectangle {
                                            height: 50px;
                                            Text {
                                                text: "No known hosts cached or matching filter";
                                                font-size: 11px;
                                                color: Theme.text-muted;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // Tab 4: Logging
                if root.active-tab == 4 : VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-primary;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            Text {
                                text: "📝  Session Logging Configuration";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            SpurxCheckBox {
                                checked <=> root.logging-enabled;
                                text: "Enable session output logging by default";
                            }

                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Log Directory:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SpurxTextInput {
                                        text <=> root.log-dir;
                                        placeholder: "(Documents/SpurXSecureSSH/logs)";
                                        horizontal-stretch: 1;
                                    }
                                    SpurxButton {
                                        text: "Browse...";
                                        variant: "secondary";
                                        custom-height: 28px;
                                        clicked => { root.browse-log-dir(); }
                                    }
                                    SpurxButton {
                                        text: "Open Folder";
                                        variant: "secondary";
                                        custom-height: 28px;
                                        clicked => { root.open-log-dir(); }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "Log Filename Format:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                                SpurxTextInput { text <=> root.log-format; placeholder: "{session}_{date}_{time}.log"; }
                            }

                            SpurxCheckBox {
                                checked <=> root.log-timestamps;
                                text: "Include timestamps in session log lines";
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // Tab 5: Behavior
                if root.active-tab == 5 : VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: Theme.border-primary;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            Text {
                                text: "⚙  Application Behavior & Session Restore";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            SpurxCheckBox {
                                checked <=> root.confirm-close;
                                text: "Confirm before closing active connected tabs";
                            }

                            SpurxCheckBox {
                                checked <=> root.restore-sessions;
                                text: "Restore previous tabs and sessions on startup";
                            }

                            SpurxCheckBox {
                                checked <=> root.remember-expanded-folders;
                                text: "Remember opened folders on startup";
                            }

                            Rectangle { height: 1px; background: Theme.border-secondary; }

                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "🖱  Sidebar Launch Behavior";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }
                                SpurxCheckBox {
                                    checked <=> root.single-click-launch;
                                    text: "Single click to launch sessions and commands (Default is double click)";
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // Footer
            Rectangle {
                height: 52px;
                background: Theme.bg-tertiary;
                border-width: 1px;
                border-color: Theme.border-secondary;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: end;
                    spacing: 10px;

                    SpurxButton {
                        text: "Cancel";
                        variant: "secondary";
                        custom-height: 32px;
                        custom-padding: 18px;
                        clicked => { root.close(); }
                    }

                    SpurxButton {
                        text: "Save Settings";
                        variant: "primary";
                        custom-height: 32px;
                        custom-padding: 20px;
                        clicked => {
                            root.save-settings(
                                root.global-username,
                                root.global-password,
                                root.default-port,
                                root.timeout-secs,
                                root.keepalive-secs,
                                root.logging-enabled,
                                root.log-dir,
                                root.log-format,
                                root.log-timestamps,
                                root.font-family,
                                root.font-size,
                                root.scrollback-lines,
                                root.cursor-blink,
                                root.confirm-close,
                                root.restore-sessions,
                                root.remember-expanded-folders,
                                root.single-click-launch,
                                root.theme-mode,
                                root.color-scheme,
                                root.accent-color
                            );
                        }
                    }
                }
            }
        }
    }
}
