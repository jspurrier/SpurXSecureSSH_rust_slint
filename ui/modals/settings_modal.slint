                                        border-color: root.accent-color == "teal" ? #ffffff : #00000040;
                                        if root.accent-color == "teal" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.accent-color = "teal"; root.accent-color-changed("teal"); } }
