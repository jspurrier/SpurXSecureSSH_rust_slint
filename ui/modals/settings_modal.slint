                                        border-width: root.accent-color == "amber" ? 2.5px : 1px;
                                        border-color: root.accent-color == "amber" ? #ffffff : #00000040;
                                        if root.accent-color == "amber" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
