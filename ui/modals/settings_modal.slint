                                    HorizontalLayout {
                                        spacing: 8px;

                                        // Sepia Warm
                                        Rectangle {
                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Sepia Warm" ? Theme.bg-active : (l7-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
