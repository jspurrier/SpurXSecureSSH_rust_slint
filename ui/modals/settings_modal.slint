                                            horizontal-stretch: 1; height: 36px; border-radius: 6px;
                                            background: root.color-scheme == "Solarized Dark" ? Theme.bg-active : (d9-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Solarized Dark" ? 1.5px : 1px;
                                            border-color: root.color-scheme == "Solarized Dark" ? Theme.accent-primary : Theme.border-secondary;
                                            HorizontalLayout {
