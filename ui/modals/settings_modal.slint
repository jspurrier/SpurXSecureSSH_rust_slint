                        }

                        // 3. Accent Highlight Color Swatches (12 Curated Colors)
                        Rectangle {
                            border-radius: 8px;
                            background: Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: Theme.border-primary;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "✨  Accent Highlight Color (13 Options)";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                    Text {
                                        text: "Applies to buttons, highlights & focus";
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                    }
                                }

                                // Row 1 of 6 Accents (Cyan, Sky, Violet, Indigo, Emerald, Lime)
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    // Cyan
                                    Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px; background: #00d4ff;
                                        border-width: root.accent-color == "cyan" ? 2.5px : 1px;
                                        border-color: root.accent-color == "cyan" ? #ffffff : #00000040;
                                        if root.accent-color == "cyan" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.accent-color = "cyan"; root.accent-color-changed("cyan"); } }
                                    }

                                    // Sky Blue
                                    Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px; background: #38bdf8;
                                        border-width: root.accent-color == "sky" ? 2.5px : 1px;
                                        border-color: root.accent-color == "sky" ? #ffffff : #00000040;
                                        if root.accent-color == "sky" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.accent-color = "sky"; root.accent-color-changed("sky"); } }
                                    }

                                    // Violet / Purple
                                    Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px; background: #a855f7;
                                        border-width: root.accent-color == "purple" ? 2.5px : 1px;
                                        border-color: root.accent-color == "purple" ? #ffffff : #00000040;
                                        if root.accent-color == "purple" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.accent-color = "purple"; root.accent-color-changed("purple"); } }
                                    }

                                    // Electric Indigo
                                    Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px; background: #6366f1;
                                        border-width: root.accent-color == "indigo" ? 2.5px : 1px;
                                        border-color: root.accent-color == "indigo" ? #ffffff : #00000040;
                                        if root.accent-color == "indigo" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.accent-color = "indigo"; root.accent-color-changed("indigo"); } }
                                    }

                                    // Emerald Green
                                    Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px; background: #10b981;
                                        border-width: root.accent-color == "emerald" ? 2.5px : 1px;
                                        border-color: root.accent-color == "emerald" ? #ffffff : #00000040;
                                        if root.accent-color == "emerald" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.accent-color = "emerald"; root.accent-color-changed("emerald"); } }
                                    }

                                    // Lime Mint
                                    Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px; background: #84cc16;
                                        border-width: root.accent-color == "lime" ? 2.5px : 1px;
                                        border-color: root.accent-color == "lime" ? #ffffff : #00000040;
                                        if root.accent-color == "lime" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.accent-color = "lime"; root.accent-color-changed("lime"); } }
                                    }
                                }

                                // Row 2 of 6 Accents (Orange, Rose, Pink, Amber, Teal, Slate)
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    // Sunset Orange
                                    Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px; background: #f97316;
                                        border-width: root.accent-color == "orange" ? 2.5px : 1px;
                                        border-color: root.accent-color == "orange" ? #ffffff : #00000040;
                                        if root.accent-color == "orange" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
