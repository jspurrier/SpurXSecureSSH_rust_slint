                                        border-color: root.accent-color == "rose" ? #ffffff : #00000040;
                                        if root.accent-color == "rose" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.accent-color = "rose"; root.accent-color-changed("rose"); } }
                                    }

                                    // Vivid Bright Red (Pure RGB 255,0,0)
                                    Rectangle {
                                        width: 28px; height: 28px; border-radius: 14px; background: #ff0000;
                                        border-width: root.accent-color == "red" ? 2.5px : 1px;
                                        border-color: root.accent-color == "red" ? #ffffff : #00000040;
                                        if root.accent-color == "red" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
