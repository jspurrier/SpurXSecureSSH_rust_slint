                                            background: root.color-scheme == "Nord Light" ? Theme.bg-active : (l4-touch.has-hover ? Theme.bg-hover : Theme.bg-secondary);
                                            border-width: root.color-scheme == "Nord Light" ? 1.5px : 1px;
