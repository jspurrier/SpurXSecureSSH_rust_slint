                                        border-width: root.accent-color == "slate" ? 2.5px : 1px;
                                        border-color: root.accent-color == "slate" ? #ffffff : #00000040;
                                        if root.accent-color == "slate" : Text { text: "✓"; font-size: 12px; font-weight: 800; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
