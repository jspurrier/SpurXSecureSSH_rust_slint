import { Theme, SpurxIconButton, SpurxTextInput, SpurxButton, SidebarIcon, LightningIcon, FolderIcon, PlusIcon, PlayIcon, TunnelIcon, SftpIcon, GearIcon, AiIcon, ServerIcon } from "theme.slint";

component ToolbarButton inherits Rectangle {
    in property <string> tooltip: "";
    in property <bool> active: false;
    in property <bool> align-left: false;
    in property <bool> align-right: false;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();

    width: 34px;
    height: 30px;
    border-radius: 6px;
    clip: false;
    background: root.active ? Theme.bg-active : (touch.has-hover ? Theme.bg-hover : Colors.transparent);

    @children

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Floating Tooltip Dropdown
    if touch.has-hover && root.tooltip != "" : Rectangle {
        y: 34px;
        width: tip-text.preferred-width + 16px;
        height: 24px;
        x: root.align-left ? 0px : (root.align-right ? (parent.width - self.width) : ((parent.width - self.width) / 2));
        background: #151b23;
        border-radius: 4px;
        border-width: 1px;
        border-color: #30363d;
        drop-shadow-blur: 8px;
        drop-shadow-color: #000000ee;
        z: 1000;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            alignment: center;
            tip-text := Text {
                text: root.tooltip;
                font-size: 11px;
                font-weight: 500;
                color: #e6edf3;
                vertical-alignment: center;
            }
        }
    }
}

export component ToolBar inherits Rectangle {
    height: Theme.toolbar-height;
    clip: false;
    background: Theme.bg-tertiary;
    border-color: Theme.border-secondary;

    in-out property <string> address-text: "";
    in property <bool> sidebar-visible: true;
    in property <bool> ai-panel-visible: false;

    callback toggle-sidebar();
    callback quick-connect();
    callback open-sessions();
    callback connect-address(string);
    callback new-tab();
    callback open-broadcast();
    callback open-ymodem();
    callback open-tunnels();
    callback open-settings();
    callback toggle-ai();

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        // Left Control Group
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            // Toggle Sidebar
            tb-side := ToolbarButton {
                tooltip: "Toggle Sidebar";
                align-left: true;
                active: root.sidebar-visible;
                clicked => { root.toggle-sidebar(); }
                SidebarIcon {
                    icon-size: 18px;
                    icon-color: root.sidebar-visible ? Theme.accent-primary : (tb-side.has-hover ? Theme.text-primary : Theme.text-secondary);
                }
            }

            // Quick Connect (Lightning)
            tb-qc := ToolbarButton {
                tooltip: "Quick Connect";
                clicked => { root.quick-connect(); }
                LightningIcon {
                    icon-size: 18px;
                    icon-color: tb-qc.has-hover ? #38bdf8 : Theme.accent-primary;
                }
            }

            // Saved Sessions (Folder)
            tb-sess := ToolbarButton {
                tooltip: "Saved Sessions";
                clicked => { root.open-sessions(); }
                FolderIcon {
                    icon-size: 18px;
                    icon-color: tb-sess.has-hover ? #a78bfa : #8b5cf6;
                }
            }

            // Separator
            Rectangle { width: 1px; height: 20px; background: Theme.border-secondary; }

            // Host Address Bar
            SpurxTextInput {
                width: 280px;
                text <=> root.address-text;
                placeholder: "Enter host <Alt+R>";
                accepted => { root.connect-address(root.address-text); }
            }

            // Connect button (Play)
            tb-play := ToolbarButton {
                tooltip: "Connect to Host";
                clicked => { root.connect-address(root.address-text); }
                PlayIcon {
                    icon-size: 16px;
                    icon-color: tb-play.has-hover ? #38bdf8 : Theme.accent-primary;
                }
            }

            // Separator
            Rectangle { width: 1px; height: 20px; background: Theme.border-secondary; }

            // New Tab (+)
            tb-nt := ToolbarButton {
                tooltip: "New Tab";
                clicked => { root.new-tab(); }
                PlusIcon {
                    icon-size: 16px;
                    icon-color: tb-nt.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }

            // SSH Tunnels
            tb-tun := ToolbarButton {
                tooltip: "SSH Tunnels";
                clicked => { root.open-tunnels(); }
                TunnelIcon {
                    icon-size: 18px;
                    icon-color: tb-tun.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }

            // SFTP / YModem
            tb-sftp := ToolbarButton {
                tooltip: "SFTP / YModem";
                clicked => { root.open-ymodem(); }
                SftpIcon {
                    icon-size: 18px;
                    icon-color: tb-sftp.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }
        }

        // Expanding Spacer pushes right controls to the far right edge
        Rectangle {
            horizontal-stretch: 1;
        }

        // Right Control Group
        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            // Settings (Gear)
            tb-set := ToolbarButton {
                tooltip: "Settings";
                align-right: true;
                clicked => { root.open-settings(); }
                GearIcon {
                    icon-size: 18px;
                    icon-color: tb-set.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }

            // AI Assistant Toggle (Robot with purple accent)
            tb-ai := ToolbarButton {
                tooltip: "AI Assistant";
                align-right: true;
                active: root.ai-panel-visible;
                clicked => { root.toggle-ai(); }
                AiIcon {
                    icon-size: 18px;
                    icon-color: root.ai-panel-visible ? #a78bfa : (tb-ai.has-hover ? #a78bfa : #8b5cf6);
                }
            }
        }
    }
}
