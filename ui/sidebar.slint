import { Theme, SpurxIconButton, SpurxTextInput, SpurxButton, FolderIcon, ServerIcon, ChevronIcon, EditIcon, CloseIcon, PlusIcon, NewFolderIcon, ImportIcon } from "theme.slint";

export struct SessionItemModel {
    id: string,
    name: string,
    host: string,
    port: int,
    folder: string,
    username: string,
    is-folder: bool,
    expanded: bool,
    count: int,
    depth: int,
}

export struct CommandItemModel {
    id: string,
    name: string,
    command: string,
    folder: string,
    color: string,
    description: string,
    is-folder: bool,
    expanded: bool,
    count: int,
    depth: int,
}

export component SideBar inherits Rectangle {
    width: Theme.sidebar-width;
    background: Theme.bg-secondary;
    border-color: Theme.border-secondary;

    in-out property <int> active-panel: 0; // 0: Sessions, 1: Commands
    in-out property <string> filter-text: "";
    in property <[SessionItemModel]> sessions: [];
    in property <[CommandItemModel]> commands: [];
    in property <bool> single-click-launch: false;
    in-out property <bool> session-menu-open: false;
    in-out property <length> session-menu-x: 0px;
    in-out property <length> session-menu-y: 0px;
    in-out property <SessionItemModel> selected-session;

    in-out property <bool> command-menu-open: false;
    in-out property <length> command-menu-x: 0px;
    in-out property <length> command-menu-y: 0px;
    in-out property <CommandItemModel> selected-command;

    in-out property <bool> folder-menu-open: false;
    in-out property <length> folder-menu-x: 0px;
    in-out property <length> folder-menu-y: 0px;
    in-out property <string> selected-folder-path: "";
    in-out property <string> selected-folder-name: "";

    callback close-sidebar();
    callback add-session();
    callback add-command();
    callback add-folder();
    callback add-subfolder(string);
    callback rename-folder(string, string);
    callback delete-folder(string);
    callback import-data();
    callback toggle-session-folder(string);
    callback toggle-command-folder(string);
    callback connect-session(SessionItemModel);
    callback edit-session(SessionItemModel);
    callback move-session(SessionItemModel);
    callback delete-session(string);
    callback run-command(CommandItemModel);
    callback edit-command(CommandItemModel);
    callback move-command(CommandItemModel);
    callback delete-command(string);
    callback filter-changed(string);

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding: 0px;

        // Sidebar Header
        Rectangle {
            z: 60;
            height: 34px;
            background: Theme.bg-tertiary;
            border-color: Theme.border-secondary;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                alignment: space-between;

                Text {
                    text: root.active-panel == 0 ? "Sessions Manager" : "Quick Commands";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: close-side-touch.has-hover ? Theme.bg-hover : Colors.transparent;

                    Text {
                        text: "◀";
                        font-size: 10px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-side-touch := TouchArea {
                        clicked => { root.close-sidebar(); }
                    }

                    if close-side-touch.has-hover : Rectangle {
                        y: 26px;
                        x: -40px;
                        width: tip-hide.preferred-width + 12px;
                        height: 22px;
                        background: #1a222d;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #30363d;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #000000bb;
                        z: 1000;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; alignment: center;
                            tip-hide := Text { text: "Hide Sidebar"; font-size: 10px; color: #e6edf3; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Toolbar Action Row (New Folder, New Item, Import)
        Rectangle {
            z: 50;
            height: 32px;
            background: Theme.bg-secondary;
            border-color: Theme.border-secondary;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: start;

                // New Folder Button
                Rectangle {
                    width: 28px;
                    height: 26px;
                    border-radius: 4px;
                    background: btn-folder-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                    NewFolderIcon {
                        icon-size: 16px;
                        icon-color: btn-folder-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                    }
                    btn-folder-touch := TouchArea { clicked => { root.add-folder(); } }

                    if btn-folder-touch.has-hover : Rectangle {
                        y: 30px;
                        x: 0px;
                        width: tip-nf.preferred-width + 12px;
                        height: 22px;
                        background: #1a222d;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #30363d;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #000000bb;
                        z: 1000;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; alignment: center;
                            tip-nf := Text { text: "New Folder"; font-size: 10px; color: #e6edf3; vertical-alignment: center; }
                        }
                    }
                }

                // Add Item Button (+)
                Rectangle {
                    width: 28px;
                    height: 26px;
                    border-radius: 4px;
                    background: btn-add-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                    PlusIcon {
                        icon-size: 16px;
                        icon-color: btn-add-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                    }
                    btn-add-touch := TouchArea {
                        clicked => {
                            if root.active-panel == 0 {
                                root.add-session();
                            } else {
                                root.add-command();
                            }
                        }
                    }

                    if btn-add-touch.has-hover : Rectangle {
                        y: 30px;
                        x: 0px;
                        width: tip-add.preferred-width + 12px;
                        height: 22px;
                        background: #1a222d;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #30363d;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #000000bb;
                        z: 1000;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; alignment: center;
                            tip-add := Text {
                                text: root.active-panel == 0 ? "Add Session" : "Add Command";
                                font-size: 10px;
                                color: #e6edf3;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Import Button
                Rectangle {
                    width: 28px;
                    height: 26px;
                    border-radius: 4px;
                    background: btn-imp-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                    ImportIcon {
                        icon-size: 16px;
                        icon-color: btn-imp-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                    }
                    btn-imp-touch := TouchArea { clicked => { root.import-data(); } }

                    if btn-imp-touch.has-hover : Rectangle {
                        y: 30px;
                        x: 0px;
                        width: tip-imp.preferred-width + 12px;
                        height: 22px;
                        background: #1a222d;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #30363d;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #000000bb;
                        z: 1000;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; alignment: center;
                            tip-imp := Text { text: "Import Sessions"; font-size: 10px; color: #e6edf3; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Search Filter Input
        HorizontalLayout {
            height: 34px;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 3px;
            padding-bottom: 3px;

            SpurxTextInput {
                placeholder: root.active-panel == 0 ? "Filter sessions..." : "Filter commands...";
                edited(str) => { root.filter-changed(str); }
            }
        }

        // List Area
        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            clip: true;

            // Scrollable List of Sessions or Commands
            flick := Flickable {
                width: 100%;
                height: 100%;
                viewport-y: 0px;

                VerticalLayout {
                    padding-left: 2px;
                    padding-right: 2px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 1px;

                    if root.active-panel == 0 : VerticalLayout {
                        spacing: 1px;
                        for session[idx] in root.sessions : row := Rectangle {
                            height: session.is-folder ? 26px : 34px;
                            border-radius: 4px;
                            background: row-touch.has-hover ? Theme.bg-hover : (!session.is-folder && root.selected-session.id == session.id) ? #264f7833 : Colors.transparent;
                            border-width: (!session.is-folder && root.selected-session.id == session.id) ? 1px : 0px;
                            border-color: (!session.is-folder && root.selected-session.id == session.id) ? Theme.accent-primary : Colors.transparent;

                            // Folder Header Row
                            if session.is-folder : HorizontalLayout {
                                padding-left: session.depth == 0 ? 6px : (session.depth * 12px + 6px);
                                padding-right: 6px;
                                spacing: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    ChevronIcon {
                                        expanded: session.expanded;
                                        icon-color: Theme.text-muted;
                                    }

                                    FolderIcon {
                                        icon-color: #f59e0b;
                                    }

                                    Text {
                                        text: session.name;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                if session.count > 0 : Text {
                                    text: "(" + session.count + ")";
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            // Session Item Row
                            if !session.is-folder : HorizontalLayout {
                                padding-left: session.depth == 0 ? 10px : (session.depth * 12px + 10px);
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    ServerIcon {
                                        icon-color: Theme.accent-primary;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;

                                        Text {
                                            text: session.name;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: (session.username != "" ? session.username + "@" : "") + session.host + (session.port != 22 ? ":" + session.port : "");
                                            font-size: 9px;
                                            color: Theme.text-muted;
                                            overflow: elide;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: edit-touch.has-hover ? Theme.bg-tertiary : Colors.transparent;

                                    EditIcon {
                                        icon-color: edit-touch.has-hover ? Theme.accent-primary : Theme.text-muted;
                                    }

                                    edit-touch := TouchArea {
                                        clicked => {
                                            root.edit-session(session);
                                        }
                                    }
                                }
                            }

                            row-touch := TouchArea {
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                        if session.is-folder {
                                            root.selected-folder-path = session.folder;
                                            root.selected-folder-name = session.name;
                                            root.folder-menu-x = 10px + self.mouse-x;
                                            root.folder-menu-y = 106px + flick.viewport-y + row.y + self.mouse-y;
                                            root.folder-menu-open = true;
                                            root.session-menu-open = false;
                                        } else {
                                            root.selected-session = session;
                                            root.session-menu-x = 10px + self.mouse-x;
                                            root.session-menu-y = 106px + flick.viewport-y + row.y + self.mouse-y;
                                            root.session-menu-open = true;
                                            root.folder-menu-open = false;
                                        }
                                    }
                                }
                                double-clicked => {
                                    if !session.is-folder && !root.single-click-launch {
                                        root.connect-session(session);
                                    }
                                }
                                clicked => {
                                    root.session-menu-open = false;
                                    root.folder-menu-open = false;
                                    if session.is-folder {
                                        root.toggle-session-folder(session.folder);
                                    } else {
                                        root.selected-session = session;
                                        if root.single-click-launch {
                                            root.connect-session(session);
                                        }
                                    }
                                }
                            }
                        }

                        if root.sessions.length == 0 : Rectangle {
                            height: 60px;
                            Text {
                                text: "No saved sessions yet";
                                font-size: 12px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.active-panel == 1 : VerticalLayout {
                        spacing: 1px;
                        for cmd[idx] in root.commands : cmd-row := Rectangle {
                            height: cmd.is-folder ? 26px : 34px;
                            border-radius: 4px;
                            background: cmd-row-touch.has-hover ? Theme.bg-hover : (!cmd.is-folder && root.selected-command.id == cmd.id) ? #264f7833 : Colors.transparent;
                            border-width: (!cmd.is-folder && root.selected-command.id == cmd.id) ? 1px : 0px;
                            border-color: (!cmd.is-folder && root.selected-command.id == cmd.id) ? Theme.accent-primary : Colors.transparent;

                            if cmd.is-folder : HorizontalLayout {
                                padding-left: cmd.depth == 0 ? 6px : (cmd.depth * 12px + 6px);
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: start;

                                ChevronIcon {
                                    expanded: cmd.expanded;
                                    icon-color: Theme.text-muted;
                                }

                                FolderIcon {
                                    icon-color: #8b5cf6;
                                }

                                Text {
                                    text: cmd.name;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                if cmd.count > 0 : Text {
                                    text: "" + cmd.count;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            if !cmd.is-folder : HorizontalLayout {
                                padding-left: cmd.depth == 0 ? 20px : (cmd.depth * 12px + 20px);
                                padding-right: 6px;
                                spacing: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    horizontal-stretch: 1;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: cmd.color == "red" ? #ef4444 :
                                                        cmd.color == "green" ? #10b981 :
                                                        cmd.color == "blue" ? #3b82f6 :
                                                        cmd.color == "yellow" ? #f59e0b :
                                                        cmd.color == "purple" ? #8b5cf6 : #06b6d4;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Text {
                                            text: cmd.name;
                                            font-size: 12px;
                                            font-weight: 500;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: cmd.command;
                                            font-size: 10px;
                                            font-family: "Cascadia Code, JetBrains Mono, monospace";
                                            color: Theme.text-secondary;
                                            overflow: elide;
                                        }
                                    }
                                }

                            }

                            cmd-row-touch := TouchArea {
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                        if cmd.is-folder {
                                            root.selected-folder-path = cmd.folder;
                                            root.selected-folder-name = cmd.name;
                                            root.folder-menu-x = 10px + self.mouse-x;
                                            root.folder-menu-y = 106px + flick.viewport-y + cmd-row.y + self.mouse-y;
                                            root.folder-menu-open = true;
                                            root.session-menu-open = false;
                                            root.command-menu-open = false;
                                        } else {
                                            root.selected-command = cmd;
                                            root.command-menu-x = 10px + self.mouse-x;
                                            root.command-menu-y = 106px + flick.viewport-y + cmd-row.y + self.mouse-y;
                                            root.command-menu-open = true;
                                            root.session-menu-open = false;
                                            root.folder-menu-open = false;
                                        }
                                    }
                                }
                                double-clicked => {
                                    if !cmd.is-folder && !root.single-click-launch {
                                        root.run-command(cmd);
                                    }
                                }
                                clicked => {
                                    root.session-menu-open = false;
                                    root.folder-menu-open = false;
                                    root.command-menu-open = false;
                                    if cmd.is-folder {
                                        root.toggle-command-folder(cmd.folder);
                                    } else {
                                        root.selected-command = cmd;
                                        if root.single-click-launch {
                                            root.run-command(cmd);
                                        }
                                    }
                                }
                            }
                        }

                        if root.commands.length == 0 : Rectangle {
                            height: 60px;
                            Text {
                                text: "No quick commands yet";
                                font-size: 12px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Panel Switcher Tabs at bottom
        Rectangle {
            height: 28px;
            background: Theme.bg-tertiary;
            border-color: Theme.border-secondary;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 4px;

                Rectangle {
                    border-radius: 4px;
                    background: root.active-panel == 0 ? Theme.bg-secondary : Colors.transparent;
                    Text {
                        text: "Sessions";
                        font-size: 11px;
                        font-weight: root.active-panel == 0 ? 700 : 500;
                        color: root.active-panel == 0 ? Theme.accent-primary : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.active-panel = 0; } }
                }

                Rectangle {
                    border-radius: 4px;
                    background: root.active-panel == 1 ? Theme.bg-secondary : Colors.transparent;
                    Text {
                        text: "Commands";
                        font-size: 11px;
                        font-weight: root.active-panel == 1 ? 700 : 500;
                        color: root.active-panel == 1 ? Theme.accent-primary : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.active-panel = 1; } }
                }
            }
        }
    }

    // Backdrop Dismiss for Context Menus
    if root.session-menu-open || root.folder-menu-open || root.command-menu-open : TouchArea {
        x: 0; y: 0; width: 10000px; height: 10000px; z: 150;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.session-menu-open = false;
                root.folder-menu-open = false;
                root.command-menu-open = false;
            }
        }
    }

    // Right-Click Context Menu Popup for Sessions
    if root.session-menu-open : Rectangle {
        x: min(root.session-menu-x, parent.width - 166px);
        y: min(root.session-menu-y, parent.height - 132px);
        width: 160px;
        height: 126px;
        border-radius: 6px;
        background: Theme.bg-elevated;
        border-width: 1px;
        border-color: Theme.border-primary;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000aa;
        z: 201;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: sm-conn-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "⚡"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Connect"; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                sm-conn-touch := TouchArea {
                    clicked => {
                        root.session-menu-open = false;
                        root.connect-session(root.selected-session);
                    }
                }
            }

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: sm-edit-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "✎"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Edit Session..."; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                sm-edit-touch := TouchArea {
                    clicked => {
                        root.session-menu-open = false;
                        root.edit-session(root.selected-session);
                    }
                }
            }

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: sm-move-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "📁"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Move to Folder..."; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                sm-move-touch := TouchArea {
                    clicked => {
                        root.session-menu-open = false;
                        root.move-session(root.selected-session);
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border-secondary; }

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: sm-del-touch.has-hover ? #f8514930 : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "🗑"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Delete"; font-size: 12px; color: #f85149; vertical-alignment: center; horizontal-stretch: 1; }
                }
                sm-del-touch := TouchArea {
                    clicked => {
                        root.session-menu-open = false;
                        root.delete-session(root.selected-session.id);
                    }
                }
            }
        }
    }

    // Right-Click Context Menu Popup for Commands
    if root.command-menu-open : Rectangle {
        x: min(root.command-menu-x, parent.width - 166px);
        y: min(root.command-menu-y, parent.height - 132px);
        width: 160px;
        height: 126px;
        border-radius: 6px;
        background: Theme.bg-elevated;
        border-width: 1px;
        border-color: Theme.border-primary;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000aa;
        z: 201;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: cm-run-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "▶"; font-size: 11px; color: #10b981; vertical-alignment: center; }
                    Text { text: "Run Command"; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                cm-run-touch := TouchArea {
                    clicked => {
                        root.command-menu-open = false;
                        root.run-command(root.selected-command);
                    }
                }
            }

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: cm-edit-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "✎"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Edit Command..."; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                cm-edit-touch := TouchArea {
                    clicked => {
                        root.command-menu-open = false;
                        root.edit-command(root.selected-command);
                    }
                }
            }

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: cm-move-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "📁"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Move to Folder..."; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                cm-move-touch := TouchArea {
                    clicked => {
                        root.command-menu-open = false;
                        root.move-command(root.selected-command);
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border-secondary; }

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: cm-del-touch.has-hover ? #f8514930 : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "🗑"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Delete"; font-size: 12px; color: #f85149; vertical-alignment: center; horizontal-stretch: 1; }
                }
                cm-del-touch := TouchArea {
                    clicked => {
                        root.command-menu-open = false;
                        root.delete-command(root.selected-command.id);
                    }
                }
            }
        }
    }

    // Right-Click Context Menu Popup for Folders
    if root.folder-menu-open : Rectangle {
        x: min(root.folder-menu-x, parent.width - 176px);
        y: min(root.folder-menu-y, parent.height - 106px);
        width: 170px;
        height: 100px;
        border-radius: 6px;
        background: Theme.bg-elevated;
        border-width: 1px;
        border-color: Theme.border-primary;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000aa;
        z: 201;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            // Add Subfolder
            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: fm-sub-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "📁"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Add Subfolder..."; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                fm-sub-touch := TouchArea {
                    clicked => {
                        root.folder-menu-open = false;
                        root.add-subfolder(root.selected-folder-path);
                    }
                }
            }

            // Rename Folder
            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: fm-ren-touch.has-hover ? Theme.bg-hover : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "✎"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Rename Folder..."; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                }
                fm-ren-touch := TouchArea {
                    clicked => {
                        root.folder-menu-open = false;
                        root.rename-folder(root.selected-folder-path, root.selected-folder-name);
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border-secondary; }

            // Delete Folder
            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: fm-del-touch.has-hover ? #f8514930 : Colors.transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px; alignment: center;
                    Text { text: "🗑"; font-size: 12px; vertical-alignment: center; }
                    Text { text: "Delete Folder"; font-size: 12px; color: #f85149; vertical-alignment: center; horizontal-stretch: 1; }
                }
                fm-del-touch := TouchArea {
                    clicked => {
                        root.folder-menu-open = false;
                        root.delete-folder(root.selected-folder-path);
                    }
                }
            }
        }
    }
}
