{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpurX Secure SSH",
  "version": "1.8.6",
  "identifier": "com.spurx.securessh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jspurrier/SpurXSecureSSH_rust_Public/releases/latest/download/latest-{{target}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGMjJFNDg2QjU4NDZEODQKUldTRWJZUzFodVFpVDRTazlORjNWZjVWVVBkTzdQVTByWkhJRlAyM0dJSnAwVmJ4SkdhWGwzbDAK"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SpurX Secure SSH",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "SpurX Secure SSH Client",
    "longDescription": "A modern, secure, and cross-platform SSH client built with Rust and Tauri.",
    "copyright": "Copyright © 2026 John Spurrier",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}