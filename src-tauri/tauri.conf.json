{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpurX Secure SSH",
  "version": "1.5.0",
  "identifier": "com.spurx.securessh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jspurrier/SpurXSecureSSH_rust_tauri/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGMjJFNDg2QjU4NDZEODQKUldTRWJZUzFodVFpVDRTazlORjNWZjVWVVBkTzdQVTByWkhJRlAyM0dJSnAwVmJ4SkdhWGwzbDAK"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SpurX Secure SSH",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}